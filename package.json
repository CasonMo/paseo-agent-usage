{
  "name": "paseo-agent-usage",
  "version": "0.7.1",
  "description": "Token usage statistics for coding agents from local session logs, with SSH collection, six analysis pages, custom dashboards, budgets, session details, and a prominent GitHub issue/PR co-creation entry.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CasonMo/paseo-agent-usage.git"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "shared/",
    "server/report.ts",
    "server/service.ts",
    "server/update-check.ts",
    "server/scan/",
    "server/remote/",
    "assets/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:collector": "node scripts/build-collector.mjs",
    "check:dashboard": "tsx scripts/check-dashboard.ts",
    "check:report": "tsx scripts/check-report.ts",
    "check": "npm run typecheck && npm run check:dashboard && npm run check:report"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.13.0-beta.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.0",
    "esbuild": "^0.28.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
